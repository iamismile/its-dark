      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#ffd54f"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f48771"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b388ff"
      }
    },
    {
      "scope": [
        "source.jsx",
        "source.tsx",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "meta.tag.jsx",
        "meta.tag.tsx",
        "source.vue",
        "entity.name.tag.vue",
        "meta.tag.vue"
      ],
      "settings": {
        "foreground": "#80cbc4"
      }
    },
    {
      "scope": [
        "source.ts meta.decorator",
        "source.ts meta.function.decorator",
        "source.js meta.decorator",
        "meta.decorator"
      ],
      "settings": {
