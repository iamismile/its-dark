  "tokenColors": [
    {
      "scope": ["strong", "markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["emphasis", "markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"],
      "settings": {
        "foreground": "#8a94a6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.block",
      "settings": {
        "foreground": "#8e44ad",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "source.cs meta.preprocessor",
      "settings": {
        "foreground": "#8a94a6"
      }
    },
    {
      "scope": [
        "storage.type",
        "source.cs storage.type",
        "support.type.exception",
        "variable.object.property",
        "source.css entity.name.tag",
        "entity.other.attribute-name",
        "variable.other.constant.property",
        "meta.definition.method entity.name.function",
        "source.cs meta.method.identifier entity.name.function",
        "text.html.markdown beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#2ecc71"
      }
    },
    {
      "scope": [
        "keyword.type",
        "support.type",
        "entity.name.type",
        "keyword.other.unit",
        "storage.type.primitive",
        "entity.other.attribute-name.id",
        "text.html.markdown markup.quote",
        "source.cs meta.method.return-type",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#2980b9"
      }
    },
    {
      "scope": [
        "string",
        "constant.numeric",
        "support.constant",
        "markup.inserted.diff",
        "constant.language.null",
        "meta.diff.header.to-file",
        "constant.language.boolean",
        "constant.language.undefined",
        "source.java constant.language",
        "source.python constant.language",
        "meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#27ae60"
      }
    },
    {
      "scope": [
        "meta.require",
        "markup.heading",
        "support.function",
        "keyword.other.get",
        "keyword.other.set",
        "meta.function-call",
        "entity.name.function",
        "variable.language.super",
        "keyword.other.special-method",
        "source.cs entity.name.function",
        "meta.function entity.name.function",
        "entity.name.section.group-title.ini",
        "source.cs meta.method-call meta.method",
        "source.java meta.method-call meta.method",
        "source.java meta.definition.variable entity.name.function",
        "source.java meta.method-call meta.inner-class meta.method meta.method-call meta.method"
      ],
      "settings": {
        "foreground": "#2c7da0"
      }
    },
    {
      "scope": [
        "source.",
        "variable",
        "meta.tag",
        "support.class",
        "support.variable",
        "support.constant",
        "text.html.derivative",
        "punctuation.definition.tag",
        "keyword.operator.arithmetic",
        "punctuation.definition.attribute.",
        "source.java storage.modifier.import",
        "source.cs entity.name.type.namespace",
        "source.java storage.modifier.package",
        "source.python meta.function-call.arguments",
        "meta.definition.variable entity.name.function",
        "source.java meta.method-call meta.inner-class meta.method"
      ],
      "settings": {
        "foreground": "#333333"
      }
    },
    {
      "scope": [
        "markup.",
        "support.node",
        "support.module",
        "entity.name.tag",
        "meta.link.reference",
        "markup.deleted.diff",
        "entity.name.tag.yaml",
        "entity.name.type.class",
        "meta.object-literal.key",
        "meta.diff.header.from-file",
        "markup.underline.link.image",
        "keyword.other.definition.ini",
        "punctuation.section.embedded",
        "meta.object-literal.key string",
        "support.type.property-name.json",
        "text.html.markdown meta.link.inline",
        "source.java storage.type.annotation",
        "source.css support.type.property-name",
        "source.cs meta.class.identifier storage.type",
        "entity.other.inherited-class entity.name.type.module",
        "source.python meta.function entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#e74c3c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold markup.", "markup. markup.bold"],
      "settings": {
        "foreground": "#e74c3c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "modifier",
        "storage.modifier",
        "constant.language",
        "support.type.object",
        "variable.language.this",
        "constant.language.json",
        "template.expression.end",
        "template.expression.begin",
        "variable.language.special.self",
        "source.js storage.modifier.async",
        "text.html.markdown markup.inline.raw",
        "source.python meta.function storage.type.function"
      ],
      "settings": {
        "foreground": "#8e44ad"
      }
    },
    {
      "scope": [
        "storage.modifier",
        "storage.type.class.js",
        "variable.language.this",
        "variable.language.this.js"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#2c7da0"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#f39c12"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#e74c3c"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#8e44ad"
      }
    },
    {
      "scope": [
        "source.jsx",
        "source.tsx",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "meta.tag.jsx",
        "meta.tag.tsx",
        "source.vue",
        "entity.name.tag.vue",
        "meta.tag.vue"
      ],
      "settings": {
        "foreground": "#2c7da0"
      }
    },
    {
      "scope": [
        "source.ts meta.decorator",
        "source.ts meta.function.decorator",
        "source.js meta.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#8e44ad"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "keyword.other.keyframe.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#27ae60"
      }
    },
    {
      "scope": [
        "keyword.other.key.yaml",
        "source.yaml key",
        "source.yaml mapping.key"
      ],
      "settings": {
        "foreground": "#8e44ad"
      }
    }
  ]
}
